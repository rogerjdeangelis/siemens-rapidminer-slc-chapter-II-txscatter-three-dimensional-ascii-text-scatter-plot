/*--- create png plot                ---*/
p <- ggplot(data = dfsas, aes(x = weight, y = height, label = sex)) +
  geom_point(color = "steelblue", size = 3, shape = 46) +
  geom_text(vjust = -0.8, size = 3, check_overlap = TRUE) +
  theme_bw()

/*--- convert ong plot to text plot  ---*/
ggplotcli(
  p
 ,width =60
 ,height = 30
 ,canvas_type = "block"
 )

